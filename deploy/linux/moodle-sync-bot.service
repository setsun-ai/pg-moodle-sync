# Telegram bot answering commands (/deadlines, /status, /sync...). Always running.
# Notifications are sent by the sync itself, independently of the bot.
[Unit]
Description=moodle-sync Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
ExecStart=@DIR@/.venv/bin/python -m moodle_sync bot
Environment=PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8
Restart=always
RestartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
